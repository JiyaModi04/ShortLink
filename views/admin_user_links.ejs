<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly Admin — User Links</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* --- RESET & THEME --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --ink:       #111010;
    --ink-mute:  #8a8585;
    --border:    #e5e7eb;
    --field-bg:  #f9fafb;
    --rp-bg:     #f4f6f9; /* Soft grey background */
    --accent-blue: #2563eb;
    --accent-light: #eff6ff;
}

html, body { 
    height: 100%; 
    font-family: 'Instrument Sans', sans-serif; 
    color: var(--ink); 
    background: var(--rp-bg);
}

.dashboard {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

/* --- HEADER --- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 900;
}

.logo span { color: var(--accent-blue); }

.back-btn {
    padding: 10px 18px;
    background: transparent;
    color: var(--ink-mute);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.back-btn:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: #fff;
    transform: translateX(-3px);
}

/* --- MAIN CARD --- */
.card {
    background: #ffffff;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.05);
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
}

h2::before {
    content: '';
    width: 4px;
    height: 24px;
    background: var(--accent-blue);
    border-radius: 10px;
}

h2 em {
    font-style: italic;
    color: var(--accent-blue);
    margin-left: 4px;
}

/* --- TABLE STYLING --- */
.table-container {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

thead {
    background: var(--field-bg);
    border-bottom: 2px solid var(--border);
}

thead th {
    padding: 16px;
    text-align: left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-mute);
    font-weight: 800;
}

tbody tr {
    border-bottom: 1px solid #f1f5f9;
}

tbody tr:hover {
    background: var(--accent-light);
}

td {
    padding: 16px;
    font-size: 14px;
    vertical-align: middle;
}

/* --- CONTENT STYLING --- */
.url-text {
    max-width: 220px;
    word-break: break-all;
    font-size: 13px;
    color: var(--ink-mute);
}

.code-badge {
    background: var(--accent-light);
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--accent-blue);
    font-weight: 700;
    font-family: monospace;
    font-size: 13px;
}

.qr-image {
    border: 1px solid var(--border);
    padding: 4px;
    background: white;
    border-radius: 6px;
}

.short-link-styled {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid transparent;
}

.short-link-styled:hover {
    border-color: var(--accent-blue);
}

/* --- BUTTONS --- */
.action-btn {
    padding: 8px 16px;
    background: var(--accent-blue);
    color: white;
    border-radius: 6px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: 0.2s;
}

.action-btn:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
}

.no-links {
    text-align: center;
    color: var(--ink-mute);
    padding: 60px;
    font-style: italic;
}
</style>

</head>

<body>

<div class="dashboard">

    <div class="header">
        <div class="logo">Short<span>ly</span></div>
        <button class="back-btn" onclick="history.back()">← Back to Admin</button>
    </div>

    <div class="card">

        <h2>Managing Links for: <em><%= user.username %></em></h2>

        <% if (links.length > 0) { %>

        <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Original Destination</th>
                    <th>Shortly URL</th>
                    <th>Code</th>
                    <th>QR Preview</th>
                    <th style="text-align:center;">Clicks</th>
                    <th>Management</th>
                </tr>
            </thead>

            <tbody>
                <% links.forEach(link => { %>
                <tr>
                    <td style="font-weight: 600; color: var(--ink-mute);">#<%= link.id %></td>

                    <td class="url-text">
                        <%= link.original_url %>
                    </td>

                    <td>
                       <a href="<%= link.short_url %>" class="short-link-styled" target="_blank">
                           <%= link.short_url %>
                       </a>
                    </td>

                    <td>
                        <span class="code-badge">
                            <%= link.short_code %>
                        </span>
                    </td>

                    <td>
                        <img src="<%= link.qrcode_path %>" width="60" class="qr-image" alt="QR Code">
                    </td>

                    <td style="text-align:center;">
                        <strong style="font-size: 16px;"><%= link.count %></strong>
                    </td>

                    <td>
                        <a href="/admin/link/<%= link.id %>" class="action-btn">
                            View Analytics
                        </a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        </div>

        <% } else { %>
            <div class="no-links">No link telemetry found for this user account.</div>
        <% } %>

    </div>

</div>

</body>
</html>