<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly Admin — Link Telemetry</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* --- RESET & VARIABLES --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --ink:       #111010;
    --ink-mute:  #8a8585;
    --red:       #c94a2a;
    --border:    #d8d2c7;
    --rp-bg:     #efe6d5;
    --rp-card:   #fffef9;
    --rp-warm:   #e2d4be;
}

html, body { 
    height: 100%; 
    font-family: 'Instrument Sans', sans-serif; 
    color: var(--ink); 
    background: var(--rp-bg);
    line-height: 1.6;
}

.dashboard {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
}

/* --- HEADER --- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 900;
}

.logo span { color: var(--red); }

.back-btn {
    padding: 10px 18px;
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.back-btn:hover {
    background: #000;
    transform: translateX(-3px);
}

/* --- CARDS --- */
.card {
    background: var(--rp-card);
    padding: 30px;
    border-radius: 22px;
    border: 1px solid rgba(201,74,42,0.16);
    box-shadow: 0 14px 44px rgba(17,16,16,0.06);
    margin-bottom: 24px;
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 12px;
}

h2::before {
    content: '';
    width: 4px;
    height: 22px;
    background: var(--red);
    border-radius: 10px;
}

/* --- INFO SECTION --- */
.link-meta {
    font-size: 14px;
    color: var(--ink-soft);
}

.link-meta p { margin-bottom: 5px; }

.link-meta strong {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-mute);
    display: block;
    margin-bottom: 2px;
}

.path-text {
    word-break: break-all;
    font-weight: 600;
    color: var(--ink);
}

/* --- STATS BOX --- */
.stats {
    display: flex;
    margin-bottom: 24px;
}

.stat-box {
    flex: 1;
    background: var(--ink);
    color: white;
    padding: 35px;
    border-radius: 22px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.stat-box h1 {
    font-family: 'Playfair Display', serif;
    font-size: 56px;
    line-height: 1;
    margin-bottom: 5px;
}

.stat-box h3 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
}

.stat-box::after {
    content: '';
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100px;
    height: 100px;
    background: var(--red);
    opacity: 0.15;
    border-radius: 50%;
}

/* --- TABLE --- */
.table-container {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

thead {
    background: #f9f7f2;
    border-bottom: 2px solid var(--border);
}

th {
    padding: 16px;
    text-align: left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-mute);
    font-weight: 700;
}

td {
    padding: 16px;
    font-size: 14px;
    color: var(--ink-soft);
    border-bottom: 1px solid #f1eee9;
}

tbody tr:hover {
    background: #fffcf5;
}

.badge {
    padding: 4px 10px;
    background: #f0f0f0;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.browser-text {
    color: var(--red);
    font-weight: 600;
}

</style>
</head>

<body>

<div class="dashboard">

    <div class="header">
        <div class="logo">Shortly<span>.</span></div>
        <button class="back-btn" onclick="history.back()">← Back</button>
    </div>

    <div class="card">
        <h2>Analytics for: <span style="color: var(--red);"><%= link.short_code %></span></h2>
        <div class="link-meta">
            <p><strong>Original Destination</strong> <span class="path-text"><%= link.original_url %></span></p>
            <p><strong>Active Shortly URL</strong> <span class="path-text"><%= link.short_url %></span></p>
        </div>
    </div>

    <div class="stats">
        <div class="stat-box">
            <h3>Total Engagements</h3>
            <h1><%= link.count %></h1>
        </div>
    </div>

    <div class="card">
        <h2>Visit Telemetry</h2>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Origin IP</th>
                        <th>Platform</th>
                        <th>User Agent</th>
                        <th>Timestamp (UTC)</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (analytics.length > 0) { %>
                        <% analytics.forEach(a => { %>
                        <tr>
                            <td style="font-family: monospace; font-weight: 600;"><%= a.ip %></td>
                            <td><span class="badge"><%= a.device %></span></td>
                            <td><span class="browser-text"><%= a.browser %></span></td>
                            <td style="color: var(--ink-mute);"><%= a.accessed_at %></td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 50px; color: var(--ink-mute);">
                                No engagement data detected for this link yet.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

</body>
</html>