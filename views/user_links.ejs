<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly — My Links</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* --- RESET & VARIABLES --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --ink:       #111010;
    --ink-mute:  #8a8585;
    --red:       #c94a2a;
    --border:    #d8d2c7;
    --rp-bg:     #efe6d5;
    --rp-card:   #fffef9;
    --rp-warm:   #e2d4be;
    --blue-soft: #e0f2fe;
    --blue-dark: #0369a1;
}

html, body { 
    height: 100%; 
    font-family: 'Instrument Sans', sans-serif; 
    color: var(--ink); 
    background: var(--rp-bg);
}

.dashboard {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

/* --- HEADER --- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 900;
}

.logo span { color: var(--red); }

.back-btn {
    padding: 10px 18px;
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.back-btn:hover {
    background: #000;
    transform: translateX(-3px);
}

/* --- MAIN CARD --- */
.card {
    background: var(--rp-card);
    padding: 40px;
    border-radius: 22px;
    border: 1px solid rgba(201,74,42,0.16);
    box-shadow: 0 14px 44px rgba(17,16,16,0.06);
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    margin-bottom: 25px;
}

/* --- TABLE STYLING --- */
.table-container {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

thead {
    background: #f9f7f2;
    border-bottom: 2px solid var(--border);
}

thead th {
    padding: 16px;
    text-align: left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-mute);
    font-weight: 700;
}

tbody tr {
    border-bottom: 1px solid #f1eee9;
    transition: 0.2s;
}

tbody tr:hover {
    background: #fffcf5;
}

td {
    padding: 16px;
    font-size: 14px;
    vertical-align: middle;
}

/* --- BADGES & LINKS --- */
.link-badge {
    background: var(--blue-soft);
    padding: 6px 12px;
    border-radius: 8px;
    display: inline-block;
}

.link-badge a {
    text-decoration: none;
    color: var(--blue-dark);
    font-weight: 600;
}

.short-code {
    font-family: monospace;
    font-weight: 600;
    color: var(--red);
    background: #fff0ed;
    padding: 2px 6px;
    border-radius: 4px;
}

/* --- QR BOX --- */
.qr-box {
    text-align: center;
}

.qr-image {
    border: 1px solid var(--border);
    padding: 4px;
    background: white;
    border-radius: 8px;
    margin-bottom: 8px;
}

.qr-actions {
    display: flex;
    gap: 8px;
    justify-content: center;
}

.qr-link {
    font-size: 12px;
    color: var(--ink-mute);
    text-decoration: none;
    font-weight: 600;
}

.qr-link:hover { color: var(--red); }

/* --- BUTTONS --- */
.action-btn {
    padding: 8px 14px;
    border-radius: 8px;
    border: none;
    background: var(--ink);
    color: white;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: 0.2s;
}

.action-btn:hover {
    background: var(--red);
    transform: translateY(-2px);
}

.btn-scan {
    background: transparent;
    border: 1.5px solid var(--border);
    color: var(--ink);
}

.btn-scan:hover {
    background: var(--ink);
    color: white;
    border-color: var(--ink);
}

/* --- SCANNER OVERLAY --- */
.scanner-overlay {
    position: fixed;
    inset: 0;
    background: rgba(17, 16, 16, 0.9);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 100;
    flex-direction: column;
}

.scanner-box {
    width: 280px;
    height: 280px;
    border: 4px solid var(--red);
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: #000;
}

.scan-line {
    position: absolute;
    width: 100%;
    height: 4px;
    background: var(--red);
    box-shadow: 0 0 15px var(--red);
    animation: scanmove 2s ease-in-out infinite;
    z-index: 2;
}

@keyframes scanmove {
    0%, 100% { top: 5%; }
    50% { top: 90%; }
}

/* --- PREVIEW MODAL --- */
.preview-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(17, 16, 16, 0.8);
    backdrop-filter: blur(4px);
    z-index: 200;
    justify-content: center;
    align-items: center;
}

.preview-content {
    background: var(--rp-card);
    padding: 30px;
    border-radius: 28px;
    position: relative;
    width: 360px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
}

.preview-content img {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--border);
}

.close-btn {
    position: absolute;
    top: -15px;
    right: -15px;
    background: var(--red);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.scan-msg {
    margin-top: 20px;
    padding: 15px;
    background: var(--blue-soft);
    border-radius: 12px;
    color: var(--blue-dark);
    font-weight: 600;
    word-break: break-all;
}

</style>
</head>

<body>

<div class="dashboard">

    <div class="header">
        <div class="logo">Shortly<span>.</span></div>
        <button class="back-btn" onclick="history.back()">← Back to Dashboard</button>
    </div>

    <div class="card">
        <h2>Active Short Links</h2>

        <% if (links.length > 0) { %>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Original Destination</th>
                        <th>Short Code</th>
                        <th>Expiry</th>
                        <th>Short Link</th>
                        <th style="text-align:center;">QR Management</th>
                        <th>Clicks</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% links.forEach(link => { %>
                    <tr>
                        <td style="color: var(--ink-mute); font-weight: 600;">#<%= link.id %></td>

                        <td style="max-width:220px; word-break:break-all; font-size: 13px; color: var(--ink-soft);">
                            <%= link.original_url %>
                        </td>

                        <td><span class="short-code"><%= link.short_code %></span></td>
                        
                        <td style="font-size: 12px; font-weight: 600;"><%= link.expiry_date %></td>

                        <td>
                            <span class="link-badge">
                                <a href="<%= link.short_url %>" target="_blank">
                                    <%= link.short_url %>
                                </a>
                            </span>
                        </td>

                        <td class="qr-box">
                            <% if(link.qrcode_path) { %>
                                <img src="<%= link.qrcode_path %>" width="60" class="qr-image">
                                <div class="qr-actions">
                                    <a href="#" class="qr-link" onclick="openPreview('<%= link.qrcode_path %>')">Preview</a>
                                    <a href="<%= link.qrcode_path %>" class="qr-link" download>Save</a>
                                    <button class="action-btn btn-scan" onclick="scanQR(this)">Scan</button>
                                </div>
                            <% } else { %>
                                <span style="font-size: 11px; color: var(--red); font-weight: 700;">NO QR GENERATED</span>
                            <% } %>
                        </td>

                        <td><strong><%= link.count %></strong></td>

                        <td>
                            <button class="action-btn" data-id="<%= link.id %>" onclick="viewAnalytics(this)">
                                Analytics
                            </button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } else { %>
            <div style="text-align:center; padding: 60px; color: var(--ink-mute);">
                <p>No active links found. Start by creating one!</p>
            </div>
        <% } %>

        <div id="scanResult"></div>
    </div>
</div>

<div id="scannerOverlay" class="scanner-overlay">
    <div class="scanner-box">
        <img id="scannerImage" src="" style="width:100%; height:100%; object-fit:contain;">
        <div class="scan-line"></div>
    </div>
    <p style="color: white; margin-top: 20px; font-weight: 600; letter-spacing: 1px;">DECRYPTING QR CODE...</p>
</div>

<div id="previewModal" class="preview-modal">
    <div class="preview-content">
        <span class="close-btn" onclick="closePreview()">×</span>
        <h3 style="margin-bottom: 15px; font-family: 'Playfair Display';">QR Preview</h3>
        <img id="previewImg" src="">
    </div>
</div>

<script type="module">
import QrScanner from "https://cdn.jsdelivr.net/npm/qr-scanner@1.4.2/qr-scanner.min.js";
window.QrScanner = QrScanner;
</script>

<script>
async function scanQR(element) {
    const overlay = document.getElementById("scannerOverlay");
    const scannerImg = document.getElementById("scannerImage");
    const resultDiv = document.getElementById("scanResult");

    try {
        overlay.style.display = "flex";
        const row = element.closest("tr");
        const img = row.querySelector(".qr-image");
        scannerImg.src = img.src;

        const image = new Image();
        image.crossOrigin = "anonymous";
        image.src = img.src;

        await new Promise(resolve => image.onload = resolve);

        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d");
        canvas.width = image.width;
        canvas.height = image.height;
        ctx.drawImage(image, 0, 0);

        // Artificial delay for "Scanning" effect
        await new Promise(resolve => setTimeout(resolve, 1500));

        const result = await QrScanner.scanImage(canvas);
        overlay.style.display = "none";

        resultDiv.className = "scan-msg";
        resultDiv.innerHTML = `Decoded Destination: <a href="${result}" target="_blank" style="color:var(--blue-dark);">${result}</a>`;

    } catch (err) {
        overlay.style.display = "none";
        resultDiv.className = "scan-msg";
        resultDiv.style.background = "#fff0ed";
        resultDiv.style.color = "var(--red)";
        resultDiv.innerText = "Error: Unable to decode this QR code.";
    }
}

function viewAnalytics(btn){
    const id = btn.getAttribute("data-id");
    window.location.href = `/user/link/${id}`;
}

function openPreview(src) {
    const modal = document.getElementById("previewModal");
    const img = document.getElementById("previewImg");
    img.src = src;
    modal.style.display = "flex";
}

function closePreview() {
    document.getElementById("previewModal").style.display = "none";
}
</script>

</body>
</html>