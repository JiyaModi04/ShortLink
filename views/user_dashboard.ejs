<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* --- RESET & VARIABLES --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --ink:       #111010;
    --ink-mute:  #8a8585;
    --red:       #c94a2a;
    --border:    #d8d2c7;
    --field-bg:  #ffffff;
    --rp-bg:     #efe6d5;
    --rp-card:   #fffef9;
    --rp-warm:   #e2d4be;
}

html, body { height: 100%; font-family: 'Instrument Sans', sans-serif; color: var(--ink); background: var(--rp-bg); }

.dashboard-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 20px;
}

/* --- HEADER --- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
}

.logo-word { 
    font-family: 'Playfair Display', serif; 
    font-size: 28px; 
    font-weight: 900; 
    letter-spacing: -0.5px; 
}

.logo-dot { color: var(--red); }

.logout-btn {
    padding: 10px 20px;
    background: transparent;
    color: var(--ink);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.logout-btn:hover {
    background: #fdf2f0;
    border-color: var(--red);
    color: var(--red);
}

/* --- CARD STYLING --- */
.card {
    background: var(--rp-card);
    padding: 40px;
    border-radius: 22px;
    border: 1px solid rgba(201,74,42,0.16);
    box-shadow: 0 14px 44px rgba(17,16,16,0.06);
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
}

.card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--red), var(--rp-warm));
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    margin-bottom: 24px;
}

/* --- INPUTS --- */
.input-group { margin-bottom: 20px; }

.input-group label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-mute);
    margin-bottom: 8px;
}

.input-group input {
    width: 100%;
    padding: 12px 16px;
    background: var(--field-bg);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition: all 0.2s;
}

.input-group input:focus {
    border-color: var(--red);
    box-shadow: 0 0 0 3.5px rgba(201,74,42,0.1);
}

/* --- RADIOS --- */
.radio-group {
    display: flex;
    gap: 16px;
    background: #f9f7f2;
    padding: 8px;
    border-radius: 12px;
    border: 1px solid var(--border);
}

.radio-group label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    cursor: pointer;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s;
    text-transform: none;
    letter-spacing: normal;
    color: var(--ink-soft);
}

.radio-group input[type="radio"] { width: auto; margin-right: 5px; cursor: pointer; }

/* --- BUTTONS --- */
.btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; }

.btn {
    padding: 14px;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.btn:hover { background: var(--red); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(201,74,42,0.2); }

.btn-secondary { background: #3a3838; }
.btn-secondary:hover { background: #000; }

.btn-full { width: 100%; margin-top: 0; }

/* --- RESULT BOX --- */
.result-box {
    display: none;
    padding: 20px;
    background: #f0f9ff;
    border-left: 4px solid #0ea5e9;
    border-radius: 12px;
    margin-top: 24px;
    word-break: break-all;
    animation: slideIn 0.3s ease-out;
}

@keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

.result-title { font-weight: 700; color: #0369a1; margin-bottom: 8px; font-size: 13px; text-transform: uppercase; }

</style>
</head>
<body>

<div class="dashboard-container">

    <div class="header">
        <div class="logo-word">Shortly<span class="logo-dot">.</span></div>
        <form action="/logout" method="post">
            <button class="logout-btn">Logout</button>
        </form>
    </div>

    <div class="card">
        <h2>Create Short Link</h2>

        <div class="input-group">
            <label>Original URL</label>
            <input type="url" id="original_url" placeholder="https://example.com/long-link-path">
        </div>

        <div class="input-group">
            <label>Link Customization</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="short_code_option" value="auto" checked onclick="toggleCustom(false)">
                    Auto Generate
                </label>
                <label>
                    <input type="radio" name="short_code_option" value="custom" onclick="toggleCustom(true)">
                    Custom Alias
                </label>
            </div>
        </div>

        <div class="input-group" id="customCodeGroup" style="display:none;">
            <label>Custom Alias Code</label>
            <input type="text" id="custom_code" placeholder="my-cool-link">
        </div>

        <div class="input-group">
            <label>Set Expiry Date</label>
            <input type="date" id="expiry_date" onclick="past_date_disable()">
        </div>

        <div class="btn-row">
            <button class="btn" onclick="generateLink()">Generate Link</button>
            <button class="btn btn-secondary" onclick="generateQR()">Generate QR</button>
        </div>

        <div id="resultBox" class="result-box">
            <div class="result-title">Success — Output</div>
            <div id="resultContent"></div>
        </div>
    </div>

    <div class="card" style="padding: 20px 40px;">
        <form action="/all_links" method="post">
            <button class="btn btn-full">View My Analytics & Links</button>
        </form>
    </div>

</div>

<script>
// --- LOGIC (UNTOUCHED) ---

function toggleCustom(show){
    document.getElementById("customCodeGroup").style.display = show ? "block" : "none";
}

function getdata(){
    return {
        original_url: document.getElementById("original_url").value,
        custom_code: document.getElementById("custom_code").value,
        expiry_date: document.getElementById("expiry_date").value,
        short_code_option: document.querySelector('input[name="short_code_option"]:checked').value
    }
}

async function generateLink(){
    const data = getdata();
    try{
        const res = await fetch("/user/dashboard/shortlink",{
            method:"POST",
            headers:{"Content-Type":"application/json"},
            body:JSON.stringify(data)
        });
        const result = await res.text();
        showResult(result);
    }catch(err){
        console.error(err);
    }
}

async function generateQR(){
    const data = getdata();
    try{
        const res = await fetch("/user/dashboard/qrcode",{
            method:"POST",
            headers:{"Content-Type":"application/json"},
            body:JSON.stringify(data)
        });
        const result = await res.text();
        showResult(result);
    }catch(err){
        console.error(err);
    }
}

function showResult(content){
    const box = document.getElementById("resultBox");
    const resultContent = document.getElementById("resultContent");
    resultContent.innerHTML = content;
    box.style.display = "block";
}

function past_date_disable(){
    const today = new Date().toISOString().split("T")[0];
    const input = document.getElementById("expiry_date");
    input.min = today;
}
</script>

</body>
</html>