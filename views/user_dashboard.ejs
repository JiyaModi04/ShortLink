<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly — Dashboard</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
*{margin:0;padding:0;box-sizing:border-box;}

:root{
  --ink:#111010;
  --border:#e5e7eb;
  --field-bg:#f9fafb;
  --rp-bg:#f4f6f9;
  --accent-blue:#2563eb;
}

body{
  font-family:'Instrument Sans',sans-serif;
  background:var(--rp-bg);
  padding:40px 20px;
}

.dashboard-container{
  max-width:500px;
  margin:auto;
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.logo{
  font-family:'Playfair Display';
  font-size:32px;
  font-weight:900;
}
.logo span{color:var(--accent-blue);}

.logout-btn{
  padding:8px 14px;
  border:1px solid var(--border);
  background:white;
  border-radius:6px;
  cursor:pointer;
}

.card{
  background:white;
  padding:30px;
  border-radius:12px;
  margin-bottom:20px;
}

.input-group{margin-bottom:15px;}
.input-group label{font-size:13px;font-weight:700;}

input,select{
  width:100%;
  padding:10px;
  border:1px solid var(--border);
  border-radius:6px;
  margin-top:5px;
}

.radio-group{
  display:flex;
  gap:10px;
}

.btn-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:10px;
}

.btn{
  padding:12px;
  background:var(--accent-blue);
  color:white;
  border:none;
  border-radius:6px;
  cursor:pointer;
}

.btn-secondary{background:black;}

.btn-outline{
  width:100%;
  background:transparent;
  border:1px solid var(--accent-blue);
  color:var(--accent-blue);
}

.result-box{
  display:none;
  margin-top:20px;
  padding:15px;
  background:#f0f9ff;
  border-radius:8px;
}
</style>
</head>

<body>

<div class="dashboard-container">

<!-- HEADER -->
<div class="header">
  <div class="logo">Short<span>ly</span></div>
  <form action="/logout" method="post">
    <button class="logout-btn">Logout</button>
  </form>
</div>

<!-- MAIN CARD -->
<div class="card">
<h2>Create Short Link</h2>

<div class="input-group">
<label>Original URL</label>
<input type="url" id="original_url">
</div>

<div class="input-group">
<label>Link Customization</label>
<div class="radio-group">
<label><input type="radio" name="short_code_option" value="auto" checked onclick="toggleCustom(false)"> Auto</label>
<label><input type="radio" name="short_code_option" value="custom" onclick="toggleCustom(true)"> Custom</label>
</div>
</div>

<div class="input-group" id="customCodeGroup" style="display:none;">
<label>Custom Alias</label>
<input type="text" id="custom_code">
</div>

<div class="input-group">
<label>Expiry Date</label>
<input type="date" id="expiry_date" onclick="past_date_disable()">
</div>

<!-- TEMPLATE -->
<div class="input-group">
<label>QR Template</label>
<select id="template" name="template">
<option value="default">Default</option>
<option value="modern">Modern Blue</option>
<option value="dark">Dark Mode</option>
<option value="sunset">Sunset</option>
<option value="forest">Forest</option>
<option value="royal">Royal Purple</option>
<option value="neon">Neon Glow</option>
<option value="gold">Golden</option>
<option value="candy">Candy Pink</option>
<option value="ocean">Ocean Blue</option>
</select>
</div>

<div class="input-group">
<label>Upload Logo (Optional)</label>
<input type="file" id="logo" accept="image/*">
</div>

<div class="btn-row">
<button class="btn" onclick="generateLink()">Shorten</button>
<button class="btn btn-secondary" onclick="generateQR()">QR Code</button>
</div>

<div id="resultBox" class="result-box">
<div id="resultContent"></div>
</div>
</div>

<div class="card" style="padding:15px;">
<form action="/all_links" method="post">
  <button class="btn btn-outline">View Analytics & All Links</button>
</form>
</div>

</div>

<script>

function toggleCustom(show){
  document.getElementById("customCodeGroup").style.display = show ? "block":"none";
}

function getdata(){
  return {
    original_url:document.getElementById("original_url").value,
    custom_code:document.getElementById("custom_code").value,
    expiry_date:document.getElementById("expiry_date").value,
    short_code_option:document.querySelector('input[name="short_code_option"]:checked').value
  }
}

// SHORT LINK
async function generateLink(){
  const data=getdata();

  const res=await fetch("/user/dashboard/shortlink",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify(data)
  });

  const result=await res.text();
  showText(result);
}

// QR GENERATION
async function generateQR(){
  const data=getdata();

  const formData=new FormData();

  formData.append("original_url",data.original_url);
  formData.append("custom_code",data.custom_code);
  formData.append("expiry_date",data.expiry_date);
  formData.append("short_code_option",data.short_code_option);
  formData.append("template",document.getElementById("template").value);

  const file=document.getElementById("logo").files[0];
  if(file){
    formData.append("logo",file);
  }

  const res=await fetch("/user/dashboard/qrcode",{
    method:"POST",
    body:formData
  });

  const result=await res.json();
  showQR(result);
}

// SHOW QR
function showQR(data){
  const box=document.getElementById("resultBox");
  const content=document.getElementById("resultContent");

  content.innerHTML=`
    <p><b>Short URL:</b> <a href="${data.short_url}" target="_blank">${data.short_url}</a></p>
    <br>
    <img src="${data.qr_path}" width="200"/>
  `;

  box.style.display="block";
}

// SHOW TEXT
function showText(content){
  const box=document.getElementById("resultBox");
  const resultContent=document.getElementById("resultContent");

  resultContent.innerHTML=content;
  box.style.display="block";
}

// DATE VALIDATION
function past_date_disable(){
  const today=new Date().toISOString().split("T")[0];
  document.getElementById("expiry_date").min=today;
}

</script>

</body>
</html>