<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shortly — Link Analytics</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* --- RESET & VARIABLES --- */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --ink:       #111010;
    --ink-mute:  #8a8585;
    --red:       #c94a2a;
    --border:    #d8d2c7;
    --rp-bg:     #efe6d5;
    --rp-card:   #fffef9;
    --rp-warm:   #e2d4be;
}

html, body { 
    height: 100%; 
    font-family: 'Instrument Sans', sans-serif; 
    color: var(--ink); 
    background: var(--rp-bg);
    line-height: 1.6;
}

.container {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px;
}

/* --- HEADER --- */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 900;
}

.logo span { color: var(--red); }

.back-btn {
    padding: 10px 18px;
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.back-btn:hover {
    background: #000;
    transform: translateX(-3px);
}

/* --- CARDS --- */
.card {
    background: var(--rp-card);
    padding: 30px;
    border-radius: 22px;
    border: 1px solid rgba(201,74,42,0.16);
    box-shadow: 0 14px 44px rgba(17,16,16,0.06);
    margin-bottom: 24px;
}

h2 {
    font-family: 'Playfair Display', serif;
    font-size: 22px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

h2::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 20px;
    background: var(--red);
    border-radius: 10px;
}

/* --- LINK INFO --- */
.link-info-grid {
    display: grid;
    gap: 10px;
}

.info-row {
    font-size: 14px;
}

.info-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--ink-mute);
    display: block;
    margin-bottom: 2px;
}

.info-value {
    color: var(--ink);
    font-weight: 600;
    word-break: break-all;
}

/* --- STATS SECTION --- */
.stats-row {
    display: flex;
    gap: 20px;
    margin-bottom: 24px;
}

.stat-card {
    flex: 1;
    background: var(--ink);
    color: white;
    padding: 30px;
    border-radius: 22px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.stat-card::after {
    content: '';
    position: absolute;
    top: -20px;
    right: -20px;
    width: 80px;
    height: 80px;
    background: var(--red);
    opacity: 0.1;
    border-radius: 50%;
}

.stat-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    line-height: 1;
    margin-bottom: 5px;
}

.stat-card p {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
    color: rgba(255,255,255,0.4);
}

/* --- TABLE STYLING --- */
.table-container {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

thead {
    background: #f9f7f2;
    border-bottom: 2px solid var(--border);
}

thead th {
    padding: 16px;
    text-align: left;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ink-mute);
    font-weight: 700;
}

tbody tr {
    border-bottom: 1px solid #f1eee9;
    transition: 0.2s;
}

tbody tr:hover {
    background: #fffcf5;
}

td {
    padding: 16px;
    font-size: 14px;
    color: var(--ink-soft);
}

.badge-device {
    padding: 4px 8px;
    background: #f0f0f0;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
}

.badge-browser {
    color: #2563eb;
    font-weight: 600;
}

@media (max-width: 768px) {
    .stats-row { flex-direction: column; }
}
</style>
</head>

<body>

<div class="container">

    <div class="header">
        <div class="logo">Shortly<span>.</span></div>
        <button class="back-btn" onclick="history.back()">← Back to Links</button>
    </div>

    <div class="card">
        <h2>Telemetry Insights</h2>
        <div class="link-info-grid">
            <div class="info-row">
                <span class="info-label">Active Link</span>
                <span class="info-value" style="color: var(--red);"><%= link.short_url %></span>
            </div>
            <div class="info-row">
                <span class="info-label">Destination Path</span>
                <span class="info-value"><%= link.original_url %></span>
            </div>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <h3><%= link.count %></h3>
            <p>Unique Engagements</p>
        </div>
    </div>

    <div class="card">
        <h2>Detailed Log</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Origin IP</th>
                        <th>Platform</th>
                        <th>Agent</th>
                        <th>Timestamp (UTC)</th>
                    </tr>
                </thead>

                <tbody>
                    <% if (analytics.length > 0) { %>
                        <% analytics.forEach(a => { %>
                        <tr>
                            <td style="font-family: monospace; font-weight: 600;"><%= a.ip %></td>
                            <td><span class="badge-device"><%= a.device %></span></td>
                            <td><span class="badge-browser"><%= a.browser %></span></td>
                            <td style="color: var(--ink-mute);"><%= a.accessed_at %></td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 40px; color: var(--ink-mute);">
                                No engagement data available yet.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

</body>
</html>